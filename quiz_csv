<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Simple CSV Quiz</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #f4f7f6; display: flex; justify-content: center; padding: 40px; }
        #quiz-card { background: white; padding: 30px; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); width: 100%; max-width: 500px; }
        .option-btn { display: block; width: 100%; margin: 12px 0; padding: 15px; border: 2px solid #eee; border-radius: 10px; cursor: pointer; background: white; font-size: 16px; transition: all 0.3s; }
        .option-btn:hover { border-color: #4A90E2; background: #f0f7ff; }
        #status { margin-top: 20px; font-weight: bold; min-height: 24px; }
        .next-btn { background: #4A90E2; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; margin-top: 10px; }
    </style>
</head>
<body>

<div id="quiz-card">
    <h2 id="question-text">Loading Quiz...</h2>
    <div id="options-container"></div>
    <div id="status"></div>
    <button class="next-btn" onclick="generateQuestion()">Skip / Next Question</button>
</div>

<script>
    let allData = [];

    // Fetch and Parse CSV
    fetch('questions.csv')
        .then(response => response.text())
        .then(text => {
            const rows = text.split('\n').slice(1); // Remove header row
            allData = rows.map(row => {
                const [question, answer] = row.split(',');
                return { Question: question?.trim(), Answer: answer?.trim() };
            }).filter(item => item.Question && item.Answer); // Clean empty rows
            
            generateQuestion();
        });

    function generateQuestion() {
        document.getElementById('status').innerText = "";
        
        // 1. Pick Random Correct Answer
        const mainIdx = Math.floor(Math.random() * allData.length);
        const correctItem = allData[mainIdx];
        
        // 2. Get 3 random WRONG answers from the rest of the list
        let pool = allData.filter((_, index) => index !== mainIdx);
        let distractors = [];
        
        while(distractors.length < 3 && pool.length > 0) {
            let randIdx = Math.floor(Math.random() * pool.length);
            let val = pool[randIdx].Answer;
            if(!distractors.includes(val)) {
                distractors.push(val);
            }
            pool.splice(randIdx, 1);
        }

        // 3. Shuffle
        let choices = [correctItem.Answer, ...distractors];
        choices.sort(() => Math.random() - 0.5);

        // 4. Render
        document.getElementById('question-text').innerText = correctItem.Question;
        const container = document.getElementById('options-container');
        container.innerHTML = '';

        choices.forEach(choice => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.innerText = choice;
            btn.onclick = () => {
                const status = document.getElementById('status');
                if(choice === correctItem.Answer) {
                    status.innerHTML = "✅ Correct!";
                    status.style.color = "#27ae60";
                } else {
                    status.innerHTML = "❌ Wrong! Try again or Skip.";
                    status.style.color = "#e74c3c";
                }
            };
            container.appendChild(btn);
        });
    }
</script>
</body>
</html>
